{
  "name": "irctc-backend",
  "private": true,
  "workspaces": [
    "user-service",
    "search-service"
  ],
  "scripts": {
    "dev:user": "npm run dev --workspace user-service",
    "dev:search": "npm run dev --workspace search-service",
    "build": "npm run build --workspace user-service && npm run build --workspace search-service",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "js-logger": "^1.6.1",
    "kafkajs": "^2.2.4"
  }
}
